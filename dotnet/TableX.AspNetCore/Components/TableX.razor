@typeparam TItem
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.JSInterop
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<CascadingValue Value="_columns" IsFixed="true">
    @ChildContent
</CascadingValue>

<div @ref="_containerRef" id="@_containerId" class="@GridClass" data-tablex-config="@_configId"></div>

<script type="application/json" id="@_configId">@((MarkupString)JsonConfig)</script>

@if (AutoInit)
{
    <script>
        (function () {
            var containerId = @((MarkupString)TableXConfigSerializer.ToJsString(_containerId));
            var configId = @((MarkupString)TableXConfigSerializer.ToJsString(_configId));
            var warning = "TableX: the browser bundle is not loaded. Reference " +
                @((MarkupString)TableXConfigSerializer.ToJsString(TableXAssets.ScriptPath)) +
                " from your App.razor, _Layout.cshtml or index.html before this grid renders.";

            function start() {
                var api = window.TableX;
                if (!api || typeof api.createTableX !== "function") {
                    if (window.console && window.console.error) window.console.error(warning);
                    return;
                }
                if (typeof api.mountFromConfig === "function") {
                    api.mountFromConfig(containerId, configId);
                    return;
                }
                var host = document.getElementById(containerId);
                var data = document.getElementById(configId);
                if (!host || !data) return;
                if (!host.tablex) {
                    host.tablex = api.createTableX(host, JSON.parse(data.textContent));
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", start);
            } else {
                start();
            }
        })();
    </script>
}

@code {
    private readonly TableXColumnCollection _columns = new();
    private ElementReference _containerRef;
    private readonly string _containerId = "tbx-blazor-" + Guid.NewGuid().ToString("N", CultureInfo.InvariantCulture)[..12];
    private string _configId => _containerId + "-config";

    protected override void OnInitialized()
    {
        _columns.OnChanged = () => _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!AutoInit) return;

        try
        {
            await JS.InvokeVoidAsync("TableX.mountFromConfig", _containerId, _configId).ConfigureAwait(false);
        }
        catch (InvalidOperationException)
        {
            // Prerendering / static SSR where JS interop is not active; the inline script handles init.
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected before render completed.
        }
        catch (JSException)
        {
            // Browser bundle not loaded yet or custom host handles init.
        }
        catch (TaskCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _columns.OnChanged = null;
        if (!AutoInit) return;

        try
        {
            await JS.InvokeVoidAsync("TableX.destroyMounted", _containerId).ConfigureAwait(false);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    /// <summary>
    /// Accessible name for the table, and the default export file prefix. Required.
    /// </summary>
    [Parameter]
    public string Caption { get; set; } = string.Empty;

    /// <summary>
    /// The endpoint the grid fetches itself, expecting a <see cref="PagedResponse{T}"/> body.
    /// </summary>
    [Parameter]
    public string? Endpoint { get; set; }

    /// <summary>
    /// Endpoint used to collect the whole filtered dataset for export. Defaults to <see cref="Endpoint"/>.
    /// </summary>
    [Parameter]
    public string? FetchEndpoint { get; set; }

    /// <summary>
    /// Extra class names for the grid root.
    /// </summary>
    [Parameter]
    public string? GridClass { get; set; }

    /// <summary>
    /// Show the global search field. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool EnableSearch { get; set; } = true;

    /// <summary>
    /// Placeholder for the search field. Overrides the locale default.
    /// </summary>
    [Parameter]
    public string? SearchPlaceholder { get; set; }

    /// <summary>
    /// Show row selection checkboxes. Defaults to <see langword="false"/>.
    /// </summary>
    [Parameter]
    public bool EnableSelection { get; set; }

    /// <summary>
    /// Row selection mode (<see cref="TableXSelectionMode.Multi"/> or <see cref="TableXSelectionMode.Single"/>).
    /// </summary>
    [Parameter]
    public TableXSelectionMode? SelectionMode { get; set; }

    /// <summary>
    /// Enable column-level filter menus in headers. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? EnableColumnFilters { get; set; }

    /// <summary>
    /// Show column header quick-action menu items (sort, pin, hide).
    /// </summary>
    [Parameter]
    public bool? EnableColumnMenu { get; set; }

    /// <summary>
    /// Enable dragging column borders to resize columns. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? EnableColumnResize { get; set; }

    /// <summary>
    /// Enable drag-and-drop column reordering on header cells. Defaults to <see langword="false"/>.
    /// </summary>
    [Parameter]
    public bool? EnableColumnReorder { get; set; }

    /// <summary>
    /// Enable DOM row virtualization for 10,000+ rows. Defaults to <see langword="false"/>.
    /// </summary>
    [Parameter]
    public bool? EnableVirtualization { get; set; }

    /// <summary>
    /// Scroll viewport max-height in pixels when <see cref="EnableVirtualization"/> is <see langword="true"/>.
    /// </summary>
    [Parameter]
    public int? VirtualHeight { get; set; }

    /// <summary>
    /// Enable column sorting globally. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? EnableSorting { get; set; }

    /// <summary>
    /// Show the Excel/CSV export menu. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool EnableExport { get; set; } = true;

    /// <summary>
    /// Export button presentation (<see cref="TableXExportMode.Menu"/>, <see cref="TableXExportMode.Split"/>, <see cref="TableXExportMode.Excel"/>, or <see cref="TableXExportMode.Csv"/>).
    /// </summary>
    [Parameter]
    public TableXExportMode? ExportMode { get; set; }

    /// <summary>
    /// Shortcut for direct 1-click Excel export.
    /// </summary>
    [Parameter]
    public bool? QuickExport { get; set; }

    /// <summary>
    /// Maximum rows collected during a full dataset export walk (0 for uncapped).
    /// </summary>
    [Parameter]
    public int? MaxExportRows { get; set; }

    /// <summary>
    /// Export file prefix. Defaults to a slug of <see cref="Caption"/>.
    /// </summary>
    [Parameter]
    public string? ExportFileName { get; set; }

    /// <summary>
    /// Unique <c>localStorage</c> key to persist column widths, column order, hidden columns, and density.
    /// </summary>
    [Parameter]
    public string? StorageKey { get; set; }

    /// <summary>
    /// Show the summary / aggregation footer row (<c>&lt;tfoot&gt;</c>).
    /// </summary>
    [Parameter]
    public bool? EnableSummaryRow { get; set; }

    /// <summary>
    /// Show the floating bulk actions bar when rows are selected. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? EnableBulkActions { get; set; }

    /// <summary>
    /// Show active filter pills beneath the toolbar. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? ShowFilterPills { get; set; }

    /// <summary>
    /// Show the entire toolbar area. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? ShowToolbar { get; set; }

    /// <summary>
    /// Show the entire footer area. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? ShowFooter { get; set; }

    /// <summary>
    /// Show the Columns visibility dropdown button. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? EnableColumns { get; set; }

    /// <summary>
    /// Show the Density dropdown button. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? EnableDensity { get; set; }

    /// <summary>
    /// Show the footer pagination controls. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? EnablePagination { get; set; }

    /// <summary>
    /// Show the rows-per-page selector in the footer. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? EnableRowsPerPage { get; set; }

    /// <summary>
    /// Show the jump-to-page input in the footer. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool? EnableJumpToPage { get; set; }

    /// <summary>
    /// Show the automatic S.No. column. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool ShowSerialNumber { get; set; } = true;

    /// <summary>
    /// Optional in-memory dataset for client-side mode.
    /// </summary>
    [Parameter]
    public IEnumerable<TItem>? Data { get; set; }

    /// <summary>
    /// Total row count when supplying a single server page via <see cref="Data"/>.
    /// </summary>
    [Parameter]
    public int? Total { get; set; }

    /// <summary>
    /// Enable client-side pagination, sorting, search, and filtering over <see cref="Data"/>.
    /// </summary>
    [Parameter]
    public bool? ClientSidePagination { get; set; }

    /// <summary>Initial 1-based page. Defaults to 1.</summary>
    [Parameter]
    public int? Page { get; set; }

    /// <summary>Initial rows per page (coerced to valid <see cref="PageSizes"/>).</summary>
    [Parameter]
    public int? PageSize { get; set; }

    /// <summary>Initial sort token, e.g. <c>enrolledAt:desc</c>.</summary>
    [Parameter]
    public string? Sort { get; set; }

    /// <summary>Initial global search query.</summary>
    [Parameter]
    public string? Search { get; set; }

    /// <summary>
    /// Initial row density. Defaults to <see cref="TableXDensity.Default"/>.
    /// </summary>
    [Parameter]
    public TableXDensity Density { get; set; } = TableXDensity.Default;

    /// <summary>
    /// Colour scheme: Light, Dark, or Auto. Defaults to <see cref="TableXTheme.Light"/>.
    /// </summary>
    [Parameter]
    public TableXTheme Theme { get; set; } = TableXTheme.Light;

    /// <summary>
    /// Emit the automatic initialization script. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool AutoInit { get; set; } = true;

    /// <summary>
    /// Child column declarations (<see cref="TableXColumn"/>).
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string JsonConfig => TableXConfigSerializer.Serialize(new TableXConfig
    {
        Caption = Caption,
        Columns = _columns,
        Data = Data,
        Total = Total,
        ClientSidePagination = ClientSidePagination,
        Endpoint = Endpoint,
        FetchEndpoint = FetchEndpoint ?? Endpoint,
        Density = TableXConfigSerializer.ToToken(Density),
        Theme = TableXConfigSerializer.ToToken(Theme),
        ClassName = GridClass,
        EnableSearch = EnableSearch,
        SearchPlaceholder = SearchPlaceholder,
        EnableSelection = EnableSelection,
        SelectionMode = TableXConfigSerializer.ToToken(SelectionMode),
        EnableColumnFilters = EnableColumnFilters,
        EnableColumnMenu = EnableColumnMenu,
        EnableColumnResize = EnableColumnResize,
        EnableColumnReorder = EnableColumnReorder,
        EnableVirtualization = EnableVirtualization,
        VirtualHeight = VirtualHeight,
        EnableSorting = EnableSorting,
        EnableExport = EnableExport,
        ExportMode = TableXConfigSerializer.ToToken(ExportMode),
        QuickExport = QuickExport,
        MaxExportRows = MaxExportRows,
        ExportFileName = ExportFileName,
        StorageKey = string.IsNullOrWhiteSpace(StorageKey) ? null : StorageKey,
        EnableSummaryRow = EnableSummaryRow,
        EnableBulkActions = EnableBulkActions,
        ShowFilterPills = ShowFilterPills,
        ShowToolbar = ShowToolbar,
        ShowFooter = ShowFooter,
        EnableColumns = EnableColumns,
        EnableDensity = EnableDensity,
        EnablePagination = EnablePagination,
        EnableRowsPerPage = EnableRowsPerPage,
        EnableJumpToPage = EnableJumpToPage,
        ShowSerialNumber = ShowSerialNumber,
        Query = BuildQueryConfig(),
    });

    private TableXQueryConfig? BuildQueryConfig()
    {
        var sort = SortSpec.TryParse(Sort, out var spec)
            ? new[] { new TableXSortConfig { Field = spec.Field, Dir = spec.Direction == SortDirection.Descending ? SortSpec.DescendingToken : SortSpec.AscendingToken } }
            : Array.Empty<TableXSortConfig>();

        var search = string.IsNullOrWhiteSpace(Search) ? null : Search;

        if (Page is null && PageSize is null && sort.Length == 0 && search is null)
        {
            return null;
        }

        return new TableXQueryConfig
        {
            Page = Page is > 0 ? Page.Value : 1,
            PageSize = PageSize is null ? PageSizes.Default : PageSizes.Coerce(PageSize.Value),
            Sort = sort,
            Q = search,
        };
    }
}
