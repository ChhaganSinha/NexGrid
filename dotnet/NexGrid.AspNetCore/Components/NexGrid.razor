@typeparam TItem
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.JSInterop
@using System.Globalization
@inject IJSRuntime JS

<CascadingValue Value="_columns" IsFixed="true">
    @ChildContent
</CascadingValue>

<div @ref="_containerRef" id="@_containerId" class="@GridClass" data-nexgrid-config="@_configId"></div>

<script type="application/json" id="@_configId">@((MarkupString)JsonConfig)</script>

@if (AutoInit)
{
    <script>
        (function () {
            var containerId = @((MarkupString)NexGridConfigSerializer.ToJsString(_containerId));
            var configId = @((MarkupString)NexGridConfigSerializer.ToJsString(_configId));
            var warning = "NexGrid: the browser bundle is not loaded. Reference " +
                @((MarkupString)NexGridConfigSerializer.ToJsString(NexGridAssets.ScriptPath)) +
                " from your App.razor, _Layout.cshtml or index.html before this grid renders.";

            function start() {
                var host = document.getElementById(containerId);
                var data = document.getElementById(configId);
                if (!host || !data) return;

                var api = window.NexGrid;
                if (!api || typeof api.createNexGrid !== "function") {
                    if (window.console && window.console.error) window.console.error(warning);
                    return;
                }

                if (!host.nexgrid) {
                    host.nexgrid = api.createNexGrid(host, JSON.parse(data.textContent));
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", start);
            } else {
                start();
            }
        })();
    </script>
}

@code {
    private readonly NexGridColumnCollection _columns = new();
    private ElementReference _containerRef;
    private readonly string _containerId = "nxg-blazor-" + Guid.NewGuid().ToString("N", CultureInfo.InvariantCulture)[..12];
    private string _configId => _containerId + "-config";

    /// <summary>
    /// Accessible name for the table, and the default export file prefix. Required.
    /// </summary>
    [Parameter]
    public string Caption { get; set; } = string.Empty;

    /// <summary>
    /// The endpoint the grid fetches itself, expecting a <see cref="PagedResponse{T}"/> body.
    /// </summary>
    [Parameter]
    public string? Endpoint { get; set; }

    /// <summary>
    /// Endpoint used to collect the whole filtered dataset for export. Defaults to <see cref="Endpoint"/>.
    /// </summary>
    [Parameter]
    public string? FetchEndpoint { get; set; }

    /// <summary>
    /// Extra class names for the grid root.
    /// </summary>
    [Parameter]
    public string? GridClass { get; set; }

    /// <summary>
    /// Show the global search field. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool EnableSearch { get; set; } = true;

    /// <summary>
    /// Placeholder for the search field. Overrides the locale default.
    /// </summary>
    [Parameter]
    public string? SearchPlaceholder { get; set; }

    /// <summary>
    /// Show row selection checkboxes. Defaults to <see langword="false"/>.
    /// </summary>
    [Parameter]
    public bool EnableSelection { get; set; }

    /// <summary>
    /// Show the Excel/CSV export menu. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool EnableExport { get; set; } = true;

    /// <summary>
    /// Export file prefix. Defaults to a slug of <see cref="Caption"/>.
    /// </summary>
    [Parameter]
    public string? ExportFileName { get; set; }

    /// <summary>
    /// Show the automatic S.No. column. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool ShowSerialNumber { get; set; } = true;

    /// <summary>
    /// Initial row density. Defaults to <see cref="NexGridDensity.Default"/>.
    /// </summary>
    [Parameter]
    public NexGridDensity Density { get; set; } = NexGridDensity.Default;

    /// <summary>
    /// Colour scheme: Light, Dark, or Auto. Defaults to <see cref="NexGridTheme.Light"/>.
    /// </summary>
    [Parameter]
    public NexGridTheme Theme { get; set; } = NexGridTheme.Light;

    /// <summary>
    /// Emit the automatic initialization script. Defaults to <see langword="true"/>.
    /// </summary>
    [Parameter]
    public bool AutoInit { get; set; } = true;

    /// <summary>
    /// Child column declarations (<see cref="NexGridColumn"/>).
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string JsonConfig => NexGridConfigSerializer.Serialize(new NexGridConfig
    {
        Caption = Caption,
        Columns = _columns,
        Endpoint = Endpoint,
        FetchEndpoint = FetchEndpoint ?? Endpoint,
        Density = NexGridConfigSerializer.ToToken(Density),
        Theme = NexGridConfigSerializer.ToToken(Theme),
        ClassName = GridClass,
        EnableSearch = EnableSearch,
        SearchPlaceholder = SearchPlaceholder,
        EnableSelection = EnableSelection,
        EnableExport = EnableExport,
        ExportFileName = ExportFileName,
        ShowSerialNumber = ShowSerialNumber,
    });
}
