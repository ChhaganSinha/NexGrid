<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    NexGrid.AspNetCore is a Razor Class Library rather than a plain class library
    for one reason: it ships the browser bundle. The RCL static web asset pipeline
    is what publishes wwwroot/ to consumers as _content/NexGrid.AspNetCore/, so an
    app gets the renderer by adding the package and nothing else.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RootNamespace>NexGrid.AspNetCore</RootNamespace>
    <AssemblyName>NexGrid.AspNetCore</AssemblyName>
    <!-- Tag Helper discovery in a consumer is by assembly name, so it must stay stable. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <IsPackable>true</IsPackable>
    <PackageId>NexGrid.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Title>NexGrid for ASP.NET Core</Title>
    <Authors>NexGrid contributors</Authors>
    <Company>NexGrid</Company>
    <Product>NexGrid</Product>
    <Description>Server-driven data grid for ASP.NET Core: Tag Helpers that render the NexGrid browser bundle, a query-string binder for NexGrid's wire format, and allowlisted IQueryable extensions that turn a page/sort/search/filter request into an EF Core-translatable query and a PagedResponse.</Description>
    <PackageTags>datagrid;data-grid;table;aspnetcore;taghelper;razor;pagination;sorting;filtering;export;iqueryable;efcore;server-side</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/ChhaganSinha/NexGrid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ChhaganSinha/NexGrid.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) NexGrid contributors</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="true" />
  </ItemGroup>

  <PropertyGroup Label="Browser assets">
    <!--
      The renderer is @nexgrid/vanilla's IIFE bundle. It is built by the JS
      toolchain, so it is a build INPUT here, not a checked-in file.
    -->
    <NexGridVanillaDist>$(MSBuildThisFileDirectory)..\..\packages\vanilla\dist\</NexGridVanillaDist>
    <NexGridWwwRoot>$(MSBuildThisFileDirectory)wwwroot\</NexGridWwwRoot>
  </PropertyGroup>

  <!--
    Keep the two copied files out of the SDK's evaluation-time `wwwroot/**` glob.
    That glob runs before any target, so on a clean tree it sees nothing and on an
    incremental build it would register the asset a second time alongside the copy
    target below. Removing here and re-adding there makes both cases identical.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\nexgrid.global.js" />
    <Content Remove="wwwroot\nexgrid.css" />
  </ItemGroup>

  <!--
    Copy the browser bundle in before static web asset discovery reads @(Content).
    Every step is guarded by Exists(): a checkout where the JS has not been built
    yet must still compile, it just produces a package with no wwwroot payload.
  -->
  <Target Name="CopyNexGridBrowserAssets"
          BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths"
          Inputs="$(NexGridVanillaDist)nexgrid.global.js;$(NexGridVanillaDist)nexgrid.css"
          Outputs="$(NexGridWwwRoot)nexgrid.global.js;$(NexGridWwwRoot)nexgrid.css">

    <Copy SourceFiles="$(NexGridVanillaDist)nexgrid.global.js"
          DestinationFolder="$(NexGridWwwRoot)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NexGridVanillaDist)nexgrid.global.js')" />

    <Copy SourceFiles="$(NexGridVanillaDist)nexgrid.css"
          DestinationFolder="$(NexGridWwwRoot)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NexGridVanillaDist)nexgrid.css')" />

    <Warning Text="NexGrid: '$(NexGridVanillaDist)nexgrid.global.js' was not found. Building without the browser bundle — run 'npm run build:vanilla' at the repository root to produce it."
             Condition="!Exists('$(NexGridVanillaDist)nexgrid.global.js')" />
  </Target>

  <!--
    Registered in a separate, always-running target: CopyNexGridBrowserAssets is
    incremental and MSBuild skips a target whose outputs are up to date, taking
    its ItemGroup with it.
  -->
  <Target Name="IncludeNexGridBrowserAssets"
          DependsOnTargets="CopyNexGridBrowserAssets"
          BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths">
    <ItemGroup>
      <Content Include="wwwroot\nexgrid.global.js" Condition="Exists('$(NexGridWwwRoot)nexgrid.global.js')" />
      <Content Include="wwwroot\nexgrid.css" Condition="Exists('$(NexGridWwwRoot)nexgrid.css')" />
    </ItemGroup>
  </Target>

  <Target Name="CleanNexGridBrowserAssets" AfterTargets="Clean">
    <Delete Files="$(NexGridWwwRoot)nexgrid.global.js;$(NexGridWwwRoot)nexgrid.css" />
  </Target>

</Project>
