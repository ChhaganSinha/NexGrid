{
  "name": "nexgrid-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "TableX — a professional, server-driven data grid for React, Angular, vanilla JS, and ASP.NET Core.",
  "license": "MIT",
  "author": "Chhagan Sinha <sinhachhagan@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChhaganSinha/NexGrid.git"
  },
  "workspaces": [
    "packages/core",
    "packages/vanilla",
    "packages/react",
    "packages/angular"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:vanilla && npm run build:react && npm run build:angular",
    "build:core": "npm run build -w @nexgrid/core",
    "build:vanilla": "npm run build -w @nexgrid/vanilla",
    "build:react": "npm run build -w @nexgrid/react",
    "build:angular": "npm run build -w @nexgrid/angular",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
