{
  "name": "@nexgrid/react",
  "version": "0.2.1",
  "description": "TableX for React and Next.js — a professional, server-driven data grid with search, sorting, selection, density, exports, and responsive card layout.",
  "license": "MIT",
  "author": "Chhagan Sinha <sinhachhagan@outlook.com>",
  "homepage": "https://github.com/ChhaganSinha/NexGrid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChhaganSinha/NexGrid.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/ChhaganSinha/NexGrid/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "tablex",
    "datagrid",
    "data-grid",
    "table",
    "server-side",
    "pagination",
    "export"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-styles.mjs",
    "test": "npm run build && node test/render.test.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@nexgrid/core": "^0.2.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
