{
  "name": "@nexgrid/vue",
  "version": "0.5.0",
  "description": "TableX for Vue 3 and Nuxt — a professional, server-driven and client-side data grid with search, sorting, filtering, virtualization, tree data, grouping, inline editing, and Excel/CSV/PDF exports.",
  "license": "MIT",
  "author": "Chhagan Sinha",
  "homepage": "https://github.com/ChhaganSinha/NexGrid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChhaganSinha/NexGrid.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/ChhaganSinha/NexGrid/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "tablex",
    "nexgrid",
    "datagrid",
    "data-grid",
    "table",
    "server-side",
    "pagination",
    "export"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-styles.mjs",
    "test": "npm run build && node test/vue.test.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@nexgrid/core": "^0.5.0"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
