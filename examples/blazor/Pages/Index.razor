@page "/"

<PageTitle>TableX Blazor Example</PageTitle>

<div class="container">
    <h1>NexGrid — Blazor (.NET 8 Server / WebAssembly)</h1>
    <p class="subtitle">
        Native Blazor components (<code>&lt;NexGrid&gt;</code> and <code>&lt;NexGridColumn&gt;</code>)
        with sticky columns, summary aggregations, drag-and-drop column reordering, split export, and EF Core / LINQ server paging.
    </p>

    <NexGrid TItem="Employee"
             Caption="Employees Directory"
             Endpoint="/api/employees"
             StorageKey="nexgrid-blazor-employees"
             ExportMode="TableXExportMode.Split"
             EnableSelection="true"
             EnableColumnReorder="true"
             EnableSummaryRow="true"
             EnableExport="true"
             PageSize="25">
        <NexGridColumn Field="id" Header="ID" Width="100" Pinned="TableXColumnPin.Left" />
        <NexGridColumn Field="name" Header="Name" MinWidth="180" Pinned="TableXColumnPin.Left" />
        <NexGridColumn Field="company" Header="Company" MinWidth="130"
                       Filterable="true"
                       FilterOptions="IPAI,CIS,NexGrid,Acme Corp" />
        <NexGridColumn Field="status" Header="Status" Align="TableXColumnAlign.Center" Width="140"
                       Filterable="true"
                       FilterOptions="Probation,Permanent,Temporary,Resigned,Consultant"
                       Editable="true"
                       EditType="TableXEditType.Select"
                       EditOptions="Probation,Permanent,Temporary,Resigned,Consultant" />
        <NexGridColumn Field="department" Header="Department" MinWidth="140"
                       Filterable="true"
                       FilterOptions="Engineering,Marketing,Sales,Support,HR" />
        <NexGridColumn Field="mobile" Header="Mobile" Width="140" />
        <NexGridColumn Field="email" Header="Email" MinWidth="200" />
        <NexGridColumn Field="score" Header="Score" Align="TableXColumnAlign.Right" Width="120"
                       FilterType="number-range"
                       Aggregation="TableXAggregation.Avg"
                       AggregationLabel="Avg:" />
    </NexGrid>
</div>
