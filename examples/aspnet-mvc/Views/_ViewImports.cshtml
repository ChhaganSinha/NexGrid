@using TableX.Example.Mvc
@using TableX.Example.Mvc.Models

@* Brings TableXAssets (and the rest of the API) into scope for the views. *@
@using TableX.AspNetCore

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@*
    This one line is what turns <table-x> and <table-x-column> from unknown
    elements into Tag Helpers. Discovery is by ASSEMBLY NAME, so it is
    "TableX.AspNetCore" whether the package arrived as a NuGet reference or a
    project reference. Forget it and the elements render as literal, inert HTML
    with no error — which is the single most common "why is my grid blank".
*@
@addTagHelper *, TableX.AspNetCore
