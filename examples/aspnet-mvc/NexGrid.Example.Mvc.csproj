<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexGrid.Example.Mvc</RootNamespace>
    <AssemblyName>NexGrid.Example.Mvc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      A ProjectReference so the example always runs against the code in this
      repository. In your own app this is a PackageReference instead:

        <PackageReference Include="NexGrid.AspNetCore" Version="0.1.0" />

      Either way the browser bundle and the stylesheet arrive as static web
      assets under _content/NexGrid.AspNetCore/ — nothing to copy or build.
      (The RCL sources those two files from packages/vanilla/dist, so run
      `npm run build:vanilla` at the repository root first if they are missing.)
    -->
    <ProjectReference Include="..\..\dotnet\NexGrid.AspNetCore\NexGrid.AspNetCore.csproj" />
  </ItemGroup>

</Project>
